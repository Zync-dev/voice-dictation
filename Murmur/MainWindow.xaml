<Window x:Class="Murmur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Murmur"
        Title="Murmur" Width="1000" Height="700" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource FontBody}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <local:DayNameConverter x:Key="DayName"/>
        <local:DayTotalsConverter x:Key="DayTotals"/>
        <!-- Width of the control column in setting rows; narrows a little in a small window (MainWindow.xaml.cs). -->
        <GridLength x:Key="ControlColumn">260</GridLength>

        <!-- Page header: a title and one short line under it. -->
        <Style x:Key="PageLead" TargetType="TextBlock" BasedOn="{StaticResource BodyMuted}">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Settings: a heading over each card; inside, rows of label and help on the left, the control in a fixed column on the right. -->
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Margin" Value="0,0,0,32"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,16"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="RowText" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowHelp" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>

        <!-- Tables -->
        <Style x:Key="TableCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="0,4,0,8"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- Shown in a table card while the table has no filled-in rows (MainWindow.xaml.cs). -->
        <Style x:Key="TableEmpty" TargetType="TextBlock" BasedOn="{StaticResource BodyMuted}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="24,100,24,24"/>
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- History: the Copy action shows when the row is hovered or has keyboard focus. -->
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="12,-4,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The plus glyph in front of an Add button's label. -->
        <Style x:Key="AddGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontIcons}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Text" Value="&#xE710;"/>
            <Setter Property="Margin" Value="0,1,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,24,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,28">
                    <Control x:Name="SidebarMark" Style="{StaticResource Mark}" Height="24" VerticalAlignment="Bottom"/>
                    <TextBlock Text="murmur" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="23"
                               Margin="7,0,0,-4" VerticalAlignment="Bottom" Foreground="{DynamicResource Ink}"/>
                </StackPanel>
                <!-- The hotkey, drawn as keys on a small sunken plate. -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="12,10,12,11">
                    <StackPanel>
                        <ContentControl x:Name="HotkeyHintKeys" Focusable="False" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Hold to dictate" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Installer, updates and first run: shown once a new version is downloaded (MainWindow.Setup.cs). -->
                <Border x:Name="UpdateReadyPanel" DockPanel.Dock="Bottom" Background="{DynamicResource ScriptSoft}" CornerRadius="10"
                        Padding="12,10,12,10" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="UpdateReadyText" Style="{StaticResource Caption}" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Text="Update ready"/>
                        <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="-12,6,0,-4" Content="Restart to update"
                                Foreground="{DynamicResource Script}" Click="UpdateRestart_Click"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Pages">
                    <ListBoxItem Content="Home" Tag="&#xE80F;"/>
                    <ListBoxItem Content="Dictionary" Tag="&#xE82D;"/>
                    <ListBoxItem Content="Snippets" Tag="&#xE77F;"/>
                    <ListBoxItem Content="Style" Tag="&#xE8D2;"/>
                    <ListBoxItem Content="Transcribe" Tag="&#xE8D6;"/>
                    <ListBoxItem Content="Settings" Tag="&#xE713;"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Home ===== -->
        <Grid x:Name="PageHome" Grid.Column="1" Margin="32,32,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hero: the promise, and the two gestures with the real hotkey drawn in. -->
            <StackPanel>
                <DockPanel>
                    <ContentControl x:Name="ModelTag" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Style="{StaticResource TagScript}" Content="Speech model ready"/>
                    <TextBlock Style="{StaticResource DisplayLg}" Text="Speak. It types."/>
                </DockPanel>
                <TextBlock x:Name="HeroHint" Style="{StaticResource BodyMuted}" Margin="0,10,0,0" LineHeight="26"/>
            </StackPanel>

            <!-- Stats: one strip, the lead number in voice with this week's words beside it. -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="20,16,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Viewbox Height="36" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="StatWords" Style="{StaticResource Stat}" Foreground="{DynamicResource VoiceInk}" Text="–"/></Viewbox>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Caption}" Text="words dictated" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <!-- Words per day for the last seven days; today is the caret. Bars are added in code. -->
                        <StackPanel x:Name="Spark" Grid.Column="1" Orientation="Horizontal" Height="24" VerticalAlignment="Bottom" Margin="10,0,0,7"
                                    Background="Transparent" ToolTip="Words per day, last 7 days" AutomationProperties.Name="Words per day, last 7 days"/>
                    </Grid>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="18,16,14,16">
                        <StackPanel>
                            <Viewbox Height="36" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Stat}"><Run x:Name="StatWpm" Text="–"/><Run x:Name="StatWpmUnit" Text=" wpm" FontFamily="{StaticResource FontBody}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkMuted}"/></TextBlock></Viewbox>
                            <TextBlock Style="{StaticResource Caption}" Text="speaking speed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="18,16,14,16">
                        <StackPanel>
                            <Viewbox Height="36" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="StatCount" Style="{StaticResource Stat}" Text="–"/></Viewbox>
                            <TextBlock x:Name="StatCountLabel" Style="{StaticResource Caption}" Text="dictations" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="18,16,14,16"
                            Background="Transparent" ToolTip="Compared with typing the same words at 40 words a minute.">
                        <StackPanel>
                            <Viewbox Height="36" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Stat}"><Run x:Name="StatSaved" Text="–"/><Run x:Name="StatSavedUnit" Text="" FontFamily="{StaticResource FontBody}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkMuted}"/></TextBlock></Viewbox>
                            <TextBlock Style="{StaticResource Caption}" Text="time saved" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,32,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Heading}" Text="History" Margin="0" VerticalAlignment="Center"/>
                <TextBox x:Name="HistorySearch" Grid.Column="1" Style="{StaticResource SearchInput}" Width="220" Tag="Search history"
                         AutomationProperties.Name="Search history" TextChanged="HistorySearch_TextChanged" KeyDown="HistorySearch_KeyDown"/>
                <Button x:Name="ClearHistoryButton" Grid.Column="2" Style="{StaticResource BtnGhostDanger}" Height="32" Content="Clear history" Margin="8,0,0,0" Click="ClearHistory_Click"/>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8,4,8,8" Margin="0">
                <Grid>
                    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource HistoryRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             KeyboardNavigation.TabNavigation="Continue" Focusable="False"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="History">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="12,12,12,4">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource DayTotals}">
                                                        <Binding Path="ItemCount"/>
                                                        <Binding Path="Items"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource DayName}}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HistoryEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ClockText}" Typography.NumeralAlignment="Tabular"
                                               Margin="0,2,0,0" VerticalAlignment="Top" TextWrapping="NoWrap"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Preview}" MaxHeight="60" TextTrimming="WordEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <ContentControl Style="{StaticResource TagCommand}" Content="Command" Margin="0,0,8,0" Height="20"
                                                            Visibility="{Binding IsCommand, Converter={StaticResource Visible}}"/>
                                            <TextBlock Style="{StaticResource KeycapText}" Foreground="{DynamicResource InkMuted}" Text="{Binding AppLower}"
                                                       VerticalAlignment="Center" Visibility="{Binding HasApp, Converter={StaticResource Visible}}"/>
                                            <TextBlock Style="{StaticResource Caption}" Text="·" Margin="6,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasApp, Converter={StaticResource Visible}}"/>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding WordsText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource RowAction}" Tag="{Binding}" Click="CopyHistory_Click"
                                            AutomationProperties.Name="Copy">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE8C8;" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- First run: sound turning into text and landing at the caret, then how to start. -->
                    <StackPanel x:Name="HistoryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="440">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="24" Margin="0,0,0,20" IsHitTestVisible="False">
                            <Rectangle Width="4" Height="19" RadiusX="2" RadiusY="2" Fill="{DynamicResource LineStrong}" VerticalAlignment="Bottom"/>
                            <Rectangle Width="4" Height="13" RadiusX="2" RadiusY="2" Fill="{DynamicResource LineStrong}" VerticalAlignment="Bottom" Margin="3,0,0,0"/>
                            <Rectangle Width="4" Height="7" RadiusX="2" RadiusY="2" Fill="{DynamicResource LineStrong}" VerticalAlignment="Bottom" Margin="3,0,0,0"/>
                            <Rectangle Width="4" Height="13" RadiusX="2" RadiusY="2" Fill="{DynamicResource LineStrong}" VerticalAlignment="Bottom" Margin="3,0,0,0"/>
                            <Rectangle Width="40" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Line}" VerticalAlignment="Bottom" Margin="12,0,0,3"/>
                            <Rectangle Width="24" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Line}" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                            <Rectangle Width="32" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Line}" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                            <Rectangle Width="4" Height="24" RadiusX="2" RadiusY="2" Fill="{DynamicResource Voice}" VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Nothing here yet" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource BodyMuted}" TextAlignment="Center" LineHeight="26"/>
                        <TextBlock Style="{StaticResource BodyMuted}" TextAlignment="Center" Text="Each dictation lands here, ready to copy again."/>
                    </StackPanel>
                    <TextBlock x:Name="HistoryNoMatch" Style="{StaticResource BodyMuted}" TextAlignment="Center" Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Dictionary ===== -->
        <Grid x:Name="PageDictionary" Grid.Column="1" Margin="32,32,32,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,24">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Top" Margin="16,3,0,0"
                        Click="AddWord_Click" AutomationProperties.Name="Add a word">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource AddGlyph}"/><TextBlock Text="Add a word" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Style="{StaticResource DisplayLg}" Text="Dictionary"/>
                    <TextBlock Style="{StaticResource PageLead}" Text="Names, brands and jargon that Murmur should spell exactly."/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource TableCard}">
                <Grid>
                    <DataGrid x:Name="DictionaryGrid" AutomationProperties.Name="Dictionary">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Term" Binding="{Binding Term}" Width="*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                            <DataGridTextColumn Header="Misheard as" Binding="{Binding MisheardAs}" Width="*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                            <!-- Learning and context: entries Murmur added from a correction you made. -->
                            <DataGridTemplateColumn Width="112" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource Tag}" Content="Learned" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Focusable="False" Visibility="{Binding Learned, Converter={StaticResource Visible}}"
                                                        ToolTip="Murmur learned this from a correction you made. Remove it if it is wrong."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Style="{StaticResource RowRemove}" Tag="{Binding}" Click="RemoveRow_Click"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="DictionaryEmpty" Style="{StaticResource TableEmpty}"
                               Text="No words yet. Add each name or term the speech model gets wrong, and Murmur spells it your way."/>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,12,0,0"
                       Text="Misheard as: what the speech model writes instead, separated by commas. Double-click a cell to edit it."/>
        </Grid>

        <!-- ===== Snippets ===== -->
        <Grid x:Name="PageSnippets" Grid.Column="1" Margin="32,32,32,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,24">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Top" Margin="16,3,0,0"
                        Click="AddSnippet_Click" AutomationProperties.Name="Add a snippet">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource AddGlyph}"/><TextBlock Text="Add a snippet" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Style="{StaticResource DisplayLg}" Text="Snippets"/>
                    <TextBlock Style="{StaticResource PageLead}" Text="Say a short phrase, get a longer text. Good for addresses, links and signatures."/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource TableCard}">
                <Grid>
                    <DataGrid x:Name="SnippetGrid" AutomationProperties.Name="Snippets">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When you say" Binding="{Binding Trigger}" Width="2*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                            <DataGridTextColumn Header="Murmur inserts" Binding="{Binding Expansion}" Width="3*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                            <DataGridTemplateColumn Width="60" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Style="{StaticResource RowRemove}" Tag="{Binding}" Click="RemoveRow_Click"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SnippetsEmpty" Style="{StaticResource TableEmpty}"
                               Text="No snippets yet. Add one for text you type often, then just say its phrase."/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16,20,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="16,0,0,0" MaxWidth="360"
                                   Text="{Binding SelectedItem.Trigger, ElementName=SnippetGrid, StringFormat='Inserted when you say “{0}”', FallbackValue='Select a snippet to edit its full text.', TargetNullValue='Select a snippet to edit its full text.'}"/>
                        <TextBlock Style="{StaticResource Label}" Text="Full text"/>
                    </DockPanel>
                    <TextBox x:Name="SnippetEditor" Style="{StaticResource InputMultiline}" Height="88" AutomationProperties.Name="Full text of the selected snippet"
                             Text="{Binding SelectedItem.Expansion, ElementName=SnippetGrid, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Style ===== -->
        <Grid x:Name="PageStyle" Grid.Column="1" Margin="32,32,32,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="132"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Style="{StaticResource DisplayLg}" Text="Style"/>
                <TextBlock Style="{StaticResource PageLead}" Text="Murmur matches your tone to the app you are writing in. Tone needs AI polish from Settings; without it only Very casual has an effect."/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Margin="0">
                <StackPanel>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource Label}" Text="Default style"/>
                            <TextBlock Style="{StaticResource RowHelp}" Text="Used in every app that is not listed below."/>
                        </StackPanel>
                        <ComboBox x:Name="DefaultStyleBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Setting_Changed" AutomationProperties.Name="Default style"/>
                    </Grid>
                    <Border Style="{StaticResource RowLine}"/>
                    <StackPanel Margin="0,16,0,20">
                        <TextBlock Style="{StaticResource Label}" Text="Your own instructions"/>
                        <TextBlock Style="{StaticResource RowHelp}" Text="For example: Use British spelling. Never use em dashes." Margin="0,2,0,8"/>
                        <TextBox x:Name="CustomInstructionsBox" Style="{StaticResource InputMultiline}" Height="60" LostFocus="Setting_Changed" AutomationProperties.Name="Your own instructions"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,32,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Bottom" Margin="16,0,0,0"
                        Click="AddAppStyle_Click" AutomationProperties.Name="Add an app">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource AddGlyph}"/><TextBlock Text="Add an app" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource Heading}" Text="By app" Margin="0"/>
                    <TextBlock Style="{StaticResource Caption}" Text="Use the app's process name, such as slack or winword." Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="3" Style="{StaticResource TableCard}">
                <Grid>
                    <DataGrid x:Name="StyleGrid" AutomationProperties.Name="Style by app">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="App" Binding="{Binding App}" Width="2*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                            <DataGridComboBoxColumn Header="Style" SelectedItemBinding="{Binding Style}" Width="*"
                                                    ItemsSource="{x:Static local:Styles.All}"/>
                            <DataGridTemplateColumn Width="60" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Style="{StaticResource RowRemove}" Tag="{Binding}" Click="RemoveRow_Click"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="StyleEmpty" Style="{StaticResource TableEmpty}"
                               Text="No apps yet. Every app uses the default style."/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Transcribe (TranscribePage.xaml) ===== -->
        <local:TranscribePage x:Name="PageTranscribe" Grid.Column="1" Visibility="Collapsed"/>

        <!-- ===== Settings ===== -->
        <ScrollViewer x:Name="PageSettings" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
            <StackPanel Margin="32,32,32,24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource DisplayLg}" Text="Settings"/>
                <TextBlock Style="{StaticResource PageLead}" Text="Changes save as you make them." Margin="0,8,0,32"/>

                <!-- Hotkeys -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Hotkeys"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Dictate"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Hold to talk. Double-tap for hands-free, press again to finish. Esc cancels."/>
                            </StackPanel>
                            <Button x:Name="DictateHotkeyButton" Grid.Column="1" Style="{StaticResource BtnHotkey}" VerticalAlignment="Center" Click="DictateHotkey_Click"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Command mode"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Select text and say what to change, or ask Murmur to write something. Needs AI polish."/>
                            </StackPanel>
                            <Button x:Name="CommandHotkeyButton" Grid.Column="1" Style="{StaticResource BtnHotkey}" VerticalAlignment="Center" Click="CommandHotkey_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==== Modes and voice commands (MainWindow.Modes.cs) ==== -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Modes and voice commands"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Translate"/>
                                <TextBlock x:Name="TranslateHelp" Style="{StaticResource RowHelp}" Text="Speak in any language. Murmur writes it in the language below."/>
                            </StackPanel>
                            <Button x:Name="TranslateHotkeyButton" Grid.Column="1" Style="{StaticResource BtnHotkey}" VerticalAlignment="Center" Click="TranslateHotkey_Click"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Translate into"/>
                                <TextBlock x:Name="TranslateTargetHelp" Style="{StaticResource RowHelp}"/>
                            </StackPanel>
                            <ComboBox x:Name="TranslateTargetBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectionChanged="ModeSetting_Changed" AutomationProperties.Name="Translate into"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Ask"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Ask a question out loud. The answer appears on the card instead of being typed. Select text first to ask about it. Needs AI polish."/>
                            </StackPanel>
                            <Button x:Name="AskHotkeyButton" Grid.Column="1" Style="{StaticResource BtnHotkey}" VerticalAlignment="Center" Click="AskHotkey_Click"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Voice commands"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="While you dictate, say “ny linje”, “nyt afsnit”, “punkt”, “komma”, “slet det” or “slet alt”. In English: “new line”, “new paragraph”, “bullet point”, “comma”, “scratch that”, “delete everything”."/>
                            </StackPanel>
                            <CheckBox x:Name="VoiceCommandsBox" Grid.Column="1" Click="ModeSetting_Changed" AutomationProperties.Name="Voice commands"/>
                        </Grid>
                        <StackPanel x:Name="HotkeyConflictPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource RowLine}"/>
                            <TextBlock x:Name="HotkeyConflictText" Style="{StaticResource RowHelp}" Foreground="{DynamicResource Danger}" Margin="0,12,0,12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- ==== end Modes and voice commands ==== -->

                <!-- ==== Hands-free (foundation): MainWindow.HandsFree.cs ==== -->
                <TextBlock x:Name="HandsFreeHeading" Style="{StaticResource SectionHeading}" Text="Hands-free"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Commands about the window in front"/>
                                <TextBlock x:Name="HandsFreeHelp" Style="{StaticResource RowHelp}" Text="In command mode, say “svar på mailen og sig ja tak”, “opsummer det her”, “hvad vil de have?” or “lav en to-do-liste”. In English: “reply to this email”, “summarize this”, “what do they want?”. Murmur reads the window only when you ask, and never sends anything for you. Needs AI polish."/>
                            </StackPanel>
                            <CheckBox x:Name="HandsFreeIntentsBox" Grid.Column="1" Click="HandsFreeSetting_Changed" AutomationProperties.Name="Commands about the window in front"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Understand free-form requests"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="When no fixed phrase fits, one call to the AI model works out what you asked for. It gets your words and the app name, never what is on screen."/>
                            </StackPanel>
                            <CheckBox x:Name="HandsFreeAiRouterBox" Grid.Column="1" Click="HandsFreeSetting_Changed" AutomationProperties.Name="Understand free-form requests"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Open the reply field"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="For “reply to this email”, Murmur presses the app’s own reply shortcut (Outlook and Thunderbird Ctrl + R, Gmail R) and pastes the draft there. Otherwise the draft waits on the card."/>
                            </StackPanel>
                            <CheckBox x:Name="ReplyOpensBox" Grid.Column="1" Click="HandsFreeSetting_Changed" AutomationProperties.Name="Open the reply field"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Read text in pictures"/>
                                <TextBlock x:Name="ScreenOcrHelp" Style="{StaticResource RowHelp}" Text="When a window has too little text, such as a scan or an image, Windows reads the picture on this PC."/>
                            </StackPanel>
                            <CheckBox x:Name="ScreenOcrBox" Grid.Column="1" Click="HandsFreeSetting_Changed" AutomationProperties.Name="Read text in pictures"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Let the AI model look at the window"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Last resort when nothing else can read it: a picture of the window goes to the vision model below, at your AI provider. Off by default."/>
                            </StackPanel>
                            <CheckBox x:Name="ScreenVisionBox" Grid.Column="1" Click="HandsFreeSetting_Changed" AutomationProperties.Name="Let the AI model look at the window"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Vision model"/>
                                <TextBlock x:Name="ScreenVisionModelHelp" Style="{StaticResource RowHelp}" Text="Empty means none. Check your provider’s current model list."/>
                            </StackPanel>
                            <TextBox x:Name="ScreenVisionModelBox" Grid.Column="1" VerticalAlignment="Center" LostFocus="HandsFreeSetting_Changed" AutomationProperties.Name="Vision model"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ==== end Hands-free (foundation) ==== -->

                <!-- ==== Hands-free: computer control (MainWindow.Control.cs) ==== -->
                <TextBlock x:Name="ControlHeading" Style="{StaticResource SectionHeading}" Text="Computer control"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Control apps and windows by voice"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="In command mode, say “åbn Slack”, “skift til Chrome”, “scroll ned”, “klik på Arkivér”, “luk vinduet”, “ny fane”, “kopiér” or “fortryd”. In English: “open Slack”, “switch to Chrome”, “scroll down”, “click Archive”, “close the window”, “undo”. Say “igen” or “again” to do it once more."/>
                            </StackPanel>
                            <CheckBox x:Name="ControlCommandsBox" Grid.Column="1" Click="ControlSetting_Changed" AutomationProperties.Name="Control apps and windows by voice"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Send a reply after you confirm"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="After Murmur pastes a reply, say “send”. The card asks first. Murmur presses the app’s send key (Outlook and Gmail Ctrl + Enter, Slack and Teams Enter) only after you say “ja” or click Send, and only while the draft is still in the reply field."/>
                            </StackPanel>
                            <CheckBox x:Name="ControlSendBox" Grid.Column="1" Click="ControlSetting_Changed" AutomationProperties.Name="Send a reply after you confirm"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Time to answer the card"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Sending, deleting, buying, closing, and Enter in mail and chat apps always wait for your yes on the card. With no answer in this time, nothing happens."/>
                            </StackPanel>
                            <ComboBox x:Name="ConfirmSecondsBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="ControlSetting_Changed" AutomationProperties.Name="Time to answer the card"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ==== end Hands-free: computer control ==== -->

                <!-- ==== Voice editing and read aloud (edit-speak): MainWindow.EditSpeak.cs ==== -->
                <TextBlock x:Name="EditSpeakHeading" Style="{StaticResource SectionHeading}" Text="Voice editing and read aloud"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Edit text by voice"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="In command mode, say “ret tirsdag til onsdag”, “marker sidste sætning”, “slet sidste sætning”, “gør det mere høfligt”, “store bogstaver” or “flyt markøren til slutningen”. In English: “change Tuesday to Wednesday”, “select the last word”, “delete the last sentence”, “make it shorter”, “capitalize that”, “go to the end”. Ctrl + Z takes each change back. Never in password fields."/>
                            </StackPanel>
                            <CheckBox x:Name="VoiceEditingBox" Grid.Column="1" Click="EditSpeakSetting_Changed" AutomationProperties.Name="Edit text by voice"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Read aloud"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="In command mode, say “læs op” or “read this aloud” for the selected text, else the window in front, or “læs mailen op” / “read the email”. “Stop”, Esc or the card’s keycap stops it; “læs langsommere” / “read faster” change the speed. Windows’ own voices, on this PC."/>
                            </StackPanel>
                            <CheckBox x:Name="ReadAloudBox" Grid.Column="1" Click="EditSpeakSetting_Changed" AutomationProperties.Name="Read aloud"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Danish voice"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="For Danish text."/>
                            </StackPanel>
                            <ComboBox x:Name="VoiceDanishBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectionChanged="EditSpeakSetting_Changed" AutomationProperties.Name="Danish voice"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="English voice"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="For English text. Murmur tells the two apart from the text itself."/>
                            </StackPanel>
                            <ComboBox x:Name="VoiceEnglishBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectionChanged="EditSpeakSetting_Changed" AutomationProperties.Name="English voice"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Reading speed"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="“Læs hurtigere” and “read slower” change it too."/>
                            </StackPanel>
                            <ComboBox x:Name="ReadSpeedBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectionChanged="EditSpeakSetting_Changed" AutomationProperties.Name="Reading speed"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Voices on this PC"/>
                                <TextBlock x:Name="VoicesHelp" Style="{StaticResource RowHelp}" Text="Add more under Windows Settings › Time &amp; language › Speech."/>
                            </StackPanel>
                            <Button x:Name="TestVoicesButton" Grid.Column="1" Style="{StaticResource BtnGhost}" VerticalAlignment="Center" Content="Test the voices" Click="TestVoices_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ==== end Voice editing and read aloud ==== -->

                <!-- ==== Hands-free: multi-step tasks (MainWindow.Tasks.cs) ==== -->
                <TextBlock x:Name="TasksHeading" Style="{StaticResource SectionHeading}" Text="Tasks"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Do tasks of several steps"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="In command mode, say “find mailen fra Daniel om tilbuddet og svar at vi går videre” or “åbn Slack og skriv til Mette at jeg er forsinket”. In English: “find the email from James and reply that I can join”. The card shows the steps first and runs them only after you say “ja” or “kør”. Sending always asks again. Esc or “stop” stops the task. Needs an AI model."/>
                            </StackPanel>
                            <CheckBox x:Name="TasksEnabledBox" Grid.Column="1" Click="TaskSetting_Changed" AutomationProperties.Name="Do tasks of several steps"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Most steps in a task"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="A task that needs more steps is not started. Say it in smaller parts."/>
                            </StackPanel>
                            <ComboBox x:Name="TaskMaxStepsBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="TaskSetting_Changed" AutomationProperties.Name="Most steps in a task"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ==== end Hands-free: multi-step tasks ==== -->

                <!-- ==== App profiles and memory of what worked (MainWindow.AppMemory.cs) ==== -->
                <TextBlock x:Name="AppMemoryHeading" Style="{StaticResource SectionHeading}" Text="What Murmur learns about apps"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Remember what worked in each app"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="When a task finds a mail by scrolling, in the Other tab or with the app's search, or opens the reply field with a shortcut, Murmur tries that way first next time and skips ways that keep failing. Only the way is kept, on this PC, never what was on the screen."/>
                            </StackPanel>
                            <CheckBox x:Name="AppMemoryEnabledBox" Grid.Column="1" Click="AppMemorySetting_Changed" AutomationProperties.Name="Remember what worked in each app"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Reset what Murmur learned about apps"/>
                                <TextBlock x:Name="AppMemoryHelp" Style="{StaticResource RowHelp}" Text="Murmur has not learned anything yet."/>
                            </StackPanel>
                            <Button x:Name="AppMemoryResetButton" Grid.Column="1" Style="{StaticResource BtnGhost}" VerticalAlignment="Center" Content="Reset" Click="AppMemoryReset_Click" AutomationProperties.Name="Reset what Murmur learned about apps"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ==== end App profiles and memory ==== -->

                <!-- ==== Problem reports (MainWindow.Reports.cs, ProblemReports.cs) ==== -->
                <TextBlock x:Name="ReportsHeading" Style="{StaticResource SectionHeading}" Text="Problem reports"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Offer a report when a step fails"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="When a task or a hands-free command fails, the card shows Report. The report holds the steps, Murmur's log and how the app's window is built, never mail text or keys. The last 10 are kept on this PC. Nothing is uploaded."/>
                            </StackPanel>
                            <CheckBox x:Name="ProblemReportsKeepBox" Grid.Column="1" Click="ReportSetting_Changed" AutomationProperties.Name="Offer a report when a step fails"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <StackPanel x:Name="ReportsList" Margin="0,8,0,8"/>
                    </StackPanel>
                </Border>
                <!-- ==== end Problem reports ==== -->

                <!-- Microphone and language -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Microphone and language"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Microphone"/>
                            </StackPanel>
                            <ComboBox x:Name="MicBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Setting_Changed" AutomationProperties.Name="Microphone"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Main language"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="The language you mostly speak. Choosing one beats letting Murmur guess."/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectionChanged="Setting_Changed" AutomationProperties.Name="Main language"/>
                        </Grid>
                        <StackPanel x:Name="SecondLanguagePanel">
                            <Border Style="{StaticResource RowLine}"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Style="{StaticResource Label}" Text="Second language"/>
                                    <TextBlock Style="{StaticResource RowHelp}" Text="Murmur picks between the two for each sentence."/>
                                </StackPanel>
                                <ComboBox x:Name="SecondLanguageBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectionChanged="Setting_Changed" AutomationProperties.Name="Second language"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Speech recognition -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Speech recognition"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Turn speech into text"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Private and offline. Audio never leaves this PC."
                                           Visibility="{Binding Visibility, ElementName=LocalPanel}"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Fastest. Your audio goes to the service below."
                                           Visibility="{Binding Visibility, ElementName=CloudPanel}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegTrack}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="EngineLocal" GroupName="Engine" Style="{StaticResource Seg}" Content="On this PC" Checked="Setting_Changed"/>
                                    <RadioButton x:Name="EngineCloud" GroupName="Engine" Style="{StaticResource Seg}" Content="Cloud" Checked="Setting_Changed"/>
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <StackPanel x:Name="LocalPanel">
                            <Border Style="{StaticResource RowLine}"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Style="{StaticResource Label}" Text="Speech model"/>
                                    <TextBlock Style="{StaticResource RowHelp}" Text="Downloads once. Larger models are more accurate and slower. Uses the graphics card when there is one."/>
                                </StackPanel>
                                <ComboBox x:Name="ModelBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Label" SelectedValuePath="Id"
                                          SelectionChanged="Model_Changed" AutomationProperties.Name="Speech model"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="CloudPanel">
                            <!-- AI providers: the speech service (MainWindow.Ai.cs). Groq, OpenAI and Mistral share their key with the AI model. -->
                            <Border Style="{StaticResource RowLine}"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Style="{StaticResource Label}" Text="Service"/>
                                    <TextBlock x:Name="SttServiceHelp" Style="{StaticResource RowHelp}"/>
                                </StackPanel>
                                <ComboBox x:Name="SttProviderBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Name"
                                          SelectionChanged="SttProvider_Changed" AutomationProperties.Name="Speech service"/>
                            </Grid>
                            <StackPanel x:Name="SttAddressRow">
                                <Border Style="{StaticResource RowLine}"/>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource Label}" Text="API address"/>
                                        <TextBlock Style="{StaticResource RowHelp}" Text="Any OpenAI-compatible speech service."/>
                                    </StackPanel>
                                    <TextBox x:Name="SttUrlBox" Grid.Column="1" VerticalAlignment="Center" LostFocus="Setting_Changed" AutomationProperties.Name="Speech API address"/>
                                </Grid>
                            </StackPanel>
                            <Border Style="{StaticResource RowLine}"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Style="{StaticResource Label}" Text="Model"/>
                                    <TextBlock x:Name="SttModelHelp" Style="{StaticResource RowHelp}"/>
                                </StackPanel>
                                <ComboBox x:Name="SttModelChoiceBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Label"
                                          SelectionChanged="SttModel_Changed" AutomationProperties.Name="Speech model"/>
                                <TextBox x:Name="SttModelBox" Grid.Column="1" VerticalAlignment="Center" LostFocus="Setting_Changed" AutomationProperties.Name="Speech model name"/>
                            </Grid>
                            <Border Style="{StaticResource RowLine}"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Style="{StaticResource Label}" Text="API key"/>
                                    <TextBlock x:Name="SttKeyHelp" Style="{StaticResource RowHelp}"/>
                                    <Button x:Name="SttKeyPageButton" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="-12,4,0,0"
                                            Click="SttKeyPage_Click"/>
                                </StackPanel>
                                <PasswordBox x:Name="SttKeyBox" Grid.Column="1" VerticalAlignment="Center" LostFocus="SttKey_LostFocus" AutomationProperties.Name="Speech API key"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AI polish: the AI provider, its key guide and model (AiProviderPanel.xaml, MainWindow.Ai.cs) -->
                <TextBlock x:Name="AiHeading" Style="{StaticResource SectionHeading}" Text="AI polish"/>
                <Border x:Name="AiCard" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <local:AiProviderPanel x:Name="AiPanel"/>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Polish dictations with AI"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Fixes grammar, applies corrections you say aloud, formats lists and matches the tone. Command mode uses the same model."/>
                            </StackPanel>
                            <CheckBox x:Name="AiCleanupBox" Grid.Column="1" HorizontalAlignment="Right" Click="Setting_Changed" AutomationProperties.Name="Polish dictations with AI"/>
                        </Grid>
                        <!-- ==== See the screen when needed (VisionLocator.cs, MainWindow.Vision.cs) ==== -->
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock x:Name="SeeScreenHeading" Style="{StaticResource Label}" Text="See the screen when needed"/>
                                <TextBlock x:Name="SeeScreenHelp" Style="{StaticResource RowHelp}" Text="When a task cannot find a button or box any other way, such as new Outlook's search box, a picture of that one app window goes to your AI provider, which says where it is. Never an app Murmur is off in, or a window with a password field in focus."/>
                            </StackPanel>
                            <CheckBox x:Name="SeeScreenBox" Grid.Column="1" HorizontalAlignment="Right" Click="SeeScreen_Changed" AutomationProperties.Name="See the screen when needed"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Model that looks"/>
                                <TextBlock x:Name="SeeScreenModelHelp" Style="{StaticResource RowHelp}" Text="A model of your provider that reads pictures."/>
                            </StackPanel>
                            <ComboBox x:Name="SeeScreenModelBox" Grid.Column="1" VerticalAlignment="Center" IsEditable="False" SelectionChanged="SeeScreen_Changed" AutomationProperties.Name="Model that looks at the screen"/>
                        </Grid>
                        <!-- ==== end See the screen when needed ==== -->
                    </StackPanel>
                </Border>

                <!-- Behaviour -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Behaviour"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Remove filler words"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Drops um and uh from what you say."/>
                            </StackPanel>
                            <CheckBox x:Name="FillersBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Remove filler words"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Add a space after each dictation"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="So the next sentence does not run into the last one."/>
                            </StackPanel>
                            <CheckBox x:Name="TrailingSpaceBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Add a space after each dictation"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Restore my clipboard"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Puts back what you had copied once the text is in."/>
                            </StackPanel>
                            <CheckBox x:Name="RestoreClipboardBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Restore my clipboard"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Start and stop sounds"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="A short tone when recording begins and ends."/>
                            </StackPanel>
                            <CheckBox x:Name="SoundsBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Start and stop sounds"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Show the pill when idle"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="A small mark at the bottom of the screen shows Murmur is ready."/>
                            </StackPanel>
                            <CheckBox x:Name="RestPillBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Show the pill when idle"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Start with Windows"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Murmur waits in the tray after you sign in."/>
                            </StackPanel>
                            <CheckBox x:Name="StartupBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Start with Windows"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==== AUDIO: sound clean-up and hands-free auto-stop (MainWindow.xaml.cs, AUDIO block) ==== -->
                <TextBlock x:Name="SoundHeading" Style="{StaticResource SectionHeading}" Text="Sound"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Finish hands-free by itself"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="When you stop talking for this long, the text goes in. The line under the card runs out first."/>
                            </StackPanel>
                            <ComboBox x:Name="AutoStopBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="AudioSetting_Changed" AutomationProperties.Name="Finish hands-free by itself"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Whisper mode"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Lifts quiet speech so whispering is understood. Also in the tray menu."/>
                            </StackPanel>
                            <CheckBox x:Name="WhisperModeBox" Grid.Column="1" Click="AudioSetting_Changed" AutomationProperties.Name="Whisper mode"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Reduce background noise"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Takes out steady sound like a fan or hum before the speech model listens."/>
                            </StackPanel>
                            <CheckBox x:Name="NoiseSuppressionBox" Grid.Column="1" Click="AudioSetting_Changed" AutomationProperties.Name="Reduce background noise"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Trim silence"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Cuts the quiet before and after you speak and shortens long pauses, so the text comes back sooner."/>
                            </StackPanel>
                            <CheckBox x:Name="TrimSilenceBox" Grid.Column="1" Click="AudioSetting_Changed" AutomationProperties.Name="Trim silence"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ==== end AUDIO ==== -->
                <!-- ==== Learning and context ==== -->
                <TextBlock x:Name="LearningHeading" Style="{StaticResource SectionHeading}" Text="Learning and context"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Learn from my corrections"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="When you fix a word Murmur just typed, such as sink to Zync, it goes into the Dictionary. Murmur watches the field for 45 seconds, never a password field."/>
                            </StackPanel>
                            <CheckBox x:Name="LearnCorrectionsBox" Grid.Column="1" Click="LearningSetting_Changed" AutomationProperties.Name="Learn from my corrections"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Use text around the cursor"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Names on screen help the speech model spell them. With AI polish, a short excerpt, such as the email you reply to, goes to the AI model as context."/>
                            </StackPanel>
                            <CheckBox x:Name="ScreenContextBox" Grid.Column="1" Click="LearningSetting_Changed" AutomationProperties.Name="Use text around the cursor"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Keep my English words"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="The names and English terms you say most, such as GitHub repository or pull request, are given to the speech model so mixed Danish and English keeps them."/>
                            </StackPanel>
                            <CheckBox x:Name="PersonalVocabularyBox" Grid.Column="1" Click="LearningSetting_Changed" AutomationProperties.Name="Keep my English words"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Excluded apps"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Murmur does nothing in these apps. Use process names separated by commas, such as keepass, 1password. Murmur never pastes into a password field."/>
                            </StackPanel>
                            <TextBox x:Name="ExcludedAppsBox" Grid.Column="1" VerticalAlignment="Center" TextChanged="LearningSetting_Changed" LostFocus="LearningSetting_Changed" AutomationProperties.Name="Excluded apps"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ==== end Learning and context ==== -->

                <!-- ===== Developer mode (MainWindow.DevMode.cs) ===== -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Developer mode"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Write code in editors and terminals"/>
                                <TextBlock Style="{StaticResource RowHelp}" TextWrapping="Wrap"
                                           Text="Say “camel case user id” for userId, or snake, kebab, pascal and constant case. Say “open paren”, “equals”, “dot” or in Danish “start parentes”, “lig med”, “prik”. In terminals there is no capital letter or closing period."/>
                            </StackPanel>
                            <CheckBox x:Name="DevModeBox" Grid.Column="1" Click="DevSetting_Changed" AutomationProperties.Name="Write code in editors and terminals"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Learn names from the open project"/>
                                <TextBlock Style="{StaticResource RowHelp}"
                                           Text="In VS Code and Cursor, file and code names from the open folder are spelled as in the project. Read on this PC only, and only from folders VS Code has opened."/>
                            </StackPanel>
                            <CheckBox x:Name="DevProjectBox" Grid.Column="1" Click="DevSetting_Changed" AutomationProperties.Name="Learn names from the open project"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Code apps"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Program names, separated by commas."/>
                                <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="-12,6,0,0" Content="Restore the default list" Click="DevAppsReset_Click"/>
                            </StackPanel>
                            <TextBox x:Name="DevAppsBox" Grid.Column="1" Style="{StaticResource InputMultiline}" Height="96" VerticalAlignment="Center"
                                     FontFamily="{StaticResource FontMono}" FontSize="12" LostFocus="DevSetting_Changed" AutomationProperties.Name="Code apps"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ===== end Developer mode ===== -->

                <!-- ==== Installer, updates and first run (MainWindow.Setup.cs) ==== -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Updates and setup"/>
                <Border x:Name="SetupCard" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock x:Name="UpdateVersionText" Style="{StaticResource Label}" Text="Murmur"/>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowHelp}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UpdateCheckButton" Content="Check now" Click="UpdateCheck_Click"/>
                                <Button x:Name="UpdateRestartButton" Style="{StaticResource BtnPrimary}" Content="Restart to update"
                                        Click="UpdateRestart_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Update automatically"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Looks for a new version every few hours and downloads it quietly. Only asks the update source below; nothing about you is sent."/>
                            </StackPanel>
                            <CheckBox x:Name="AutoUpdateBox" Grid.Column="1" Click="UpdateSetting_Changed" AutomationProperties.Name="Update automatically"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Update source"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="A GitHub repository with releases, or a folder that holds build-installer.ps1 output."/>
                            </StackPanel>
                            <TextBox x:Name="UpdateSourceBox" Grid.Column="1" VerticalAlignment="Center" LostFocus="UpdateSetting_Changed" AutomationProperties.Name="Update source"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource ControlColumn}"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="GitHub access token"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Only for a private repository: a token that can read its contents. Stored encrypted for your Windows account."/>
                            </StackPanel>
                            <PasswordBox x:Name="UpdateTokenBox" Grid.Column="1" VerticalAlignment="Center" LostFocus="UpdateSetting_Changed" AutomationProperties.Name="GitHub access token"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="Setup"/>
                                <TextBlock Style="{StaticResource RowHelp}" Text="Walk through the microphone, languages and hotkey practice again."/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Content="Run setup again" Click="RunSetup_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ==== end Installer, updates and first run ==== -->

                <TextBlock x:Name="DataPathText" Style="{StaticResource Caption}" Margin="0,-8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
