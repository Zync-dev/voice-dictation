<Window x:Class="Murmur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Murmur"
        Title="Murmur" Width="1000" Height="700" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource FontBody}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- Setting row: label and one line of help on the left, the control on the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="FieldHelp" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="TableCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,24,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,24">
                    <Control x:Name="SidebarMark" Style="{StaticResource Mark}" Height="24" VerticalAlignment="Bottom"/>
                    <TextBlock Text="murmur" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="23"
                               Margin="7,0,0,-4" VerticalAlignment="Bottom" Foreground="{DynamicResource Ink}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0">
                    <ContentControl x:Name="HotkeyHintKeys" Focusable="False" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Caption}" Text="Hold to dictate" Margin="0,6,0,0"/>
                </StackPanel>
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Content="Home"/>
                    <ListBoxItem Content="Dictionary"/>
                    <ListBoxItem Content="Snippets"/>
                    <ListBoxItem Content="Style"/>
                    <ListBoxItem Content="Settings"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Home ===== -->
        <Grid x:Name="PageHome" Grid.Column="1" Margin="32,32,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <ContentControl x:Name="ModelTag" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,8,0,0"
                                Style="{StaticResource TagScript}" Content="Speech model ready"/>
                <StackPanel>
                    <TextBlock Style="{StaticResource DisplayLg}" Text="Speak. It types."/>
                    <TextBlock Style="{StaticResource BodyMuted}" Text="Click into any text field, hold the hotkey and talk." Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="-8,24,-8,24">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="StatWords" Style="{StaticResource Stat}" Foreground="{DynamicResource VoiceInk}" Text="-"/></Viewbox>
                        <TextBlock Style="{StaticResource Caption}" Text="words dictated"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Stat}"><Run x:Name="StatWpm" Text="-"/><Run Text=" wpm" FontFamily="{StaticResource FontBody}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkMuted}"/></TextBlock></Viewbox>
                        <TextBlock Style="{StaticResource Caption}" Text="speaking speed"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="StatCount" Style="{StaticResource Stat}" Text="-"/></Viewbox>
                        <TextBlock Style="{StaticResource Caption}" Text="dictations"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Stat}"><Run x:Name="StatSaved" Text="-"/><Run x:Name="StatSavedUnit" Text=" min" FontFamily="{StaticResource FontBody}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkMuted}"/></TextBlock></Viewbox>
                        <TextBlock Style="{StaticResource Caption}" Text="saved against typing at 40 wpm"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Clear history" Click="ClearHistory_Click"/>
                <TextBlock Style="{StaticResource Overline}" Text="HISTORY" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0">
                <Grid>
                    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource HistoryRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HistoryEntry}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Content="Copy" Tag="{Binding}" Click="CopyHistory_Click"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{Binding Mode}">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource TagVoice}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCommand}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource CommandSoft}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Command}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                            <TextBlock Style="{StaticResource KeycapText}" Text="{Binding AppLower}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding TimeText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding WordsText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Text}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="HistoryEmpty" Style="{StaticResource BodyMuted}" TextAlignment="Center" Margin="24"
                               Text="Nothing here yet. Click into any text field, hold the hotkey and talk."
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Dictionary ===== -->
        <DockPanel x:Name="PageDictionary" Grid.Column="1" Margin="32,32,32,24" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource DisplayLg}" Text="Dictionary"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyMuted}" Margin="0,8,0,24" MaxWidth="680" HorizontalAlignment="Left"
                       Text="Names, brands and jargon you want spelled exactly. If the speech model still gets one wrong, list what it writes instead under Misheard as, separated by commas. Click the empty bottom row to add a word. Press Delete to remove one."/>
            <Border Style="{StaticResource TableCard}">
                <DataGrid x:Name="DictionaryGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TERM" Binding="{Binding Term}" Width="*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                        <DataGridTextColumn Header="MISHEARD AS" Binding="{Binding MisheardAs}" Width="*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ===== Snippets ===== -->
        <DockPanel x:Name="PageSnippets" Grid.Column="1" Margin="32,32,32,24" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource DisplayLg}" Text="Snippets"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyMuted}" Margin="0,8,0,24" MaxWidth="680" HorizontalAlignment="Left"
                       Text="Say a short phrase, get a long text. Wherever the phrase appears in what you dictate, Murmur inserts the text instead. Good for addresses, links and signatures."/>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Text of the selected snippet"/>
                    <TextBlock Style="{StaticResource Caption}" Text="Use this box for text with more than one line." Margin="0,2,0,8"/>
                    <TextBox x:Name="SnippetEditor" Style="{StaticResource InputMultiline}" Height="88"
                             Text="{Binding SelectedItem.Expansion, ElementName=SnippetGrid, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TableCard}">
                <DataGrid x:Name="SnippetGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="WHEN I SAY" Binding="{Binding Trigger}" Width="2*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                        <DataGridTextColumn Header="INSERT" Binding="{Binding Expansion}" Width="3*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ===== Style ===== -->
        <DockPanel x:Name="PageStyle" Grid.Column="1" Margin="32,32,32,24" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource DisplayLg}" Text="Style"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyMuted}" Margin="0,8,0,24" MaxWidth="680" HorizontalAlignment="Left"
                       Text="Murmur matches the tone of your text to the app you are dictating into. Tone needs the AI model from Settings. Without it only Very casual has an effect."/>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Default style" Margin="0,0,0,6"/>
                    <ComboBox x:Name="DefaultStyleBox" Width="220" HorizontalAlignment="Left" SelectionChanged="Setting_Changed"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Your own instructions"/>
                    <TextBox x:Name="CustomInstructionsBox" Style="{StaticResource InputMultiline}" Height="64" LostFocus="Setting_Changed"/>
                    <TextBlock Style="{StaticResource FieldHelp}" Text="For example: Use British spelling. Never use em dashes."/>
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Overline}" Text="STYLE BY APP" Margin="0,8,0,8"/>
            <Border Style="{StaticResource TableCard}">
                <DataGrid x:Name="StyleGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="APP (PROCESS NAME)" Binding="{Binding App}" Width="2*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}"/>
                        <DataGridComboBoxColumn Header="STYLE" SelectedItemBinding="{Binding Style}" Width="*"
                                                ItemsSource="{x:Static local:Styles.All}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ===== Settings ===== -->
        <ScrollViewer x:Name="PageSettings" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
            <StackPanel Margin="32,32,32,24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource DisplayLg}" Text="Settings"/>
                <TextBlock Style="{StaticResource BodyMuted}" Text="Every setting saves the moment you change it." Margin="0,8,0,24"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Hotkeys"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Dictate"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Hold to talk, release to insert. Double-tap to keep talking hands-free, then press again to finish. Esc cancels."/>
                            </StackPanel>
                            <Button x:Name="DictateHotkeyButton" Grid.Column="1" Style="{StaticResource BtnHotkey}" VerticalAlignment="Top" Click="DictateHotkey_Click"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Command mode"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Select text and say what to do with it, or with nothing selected ask Murmur to write something. Needs the AI model below."/>
                            </StackPanel>
                            <Button x:Name="CommandHotkeyButton" Grid.Column="1" Style="{StaticResource BtnHotkey}" VerticalAlignment="Top" Click="CommandHotkey_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Microphone and language"/>
                        <TextBlock Style="{StaticResource Label}" Text="Microphone" Margin="0,0,0,6"/>
                        <ComboBox x:Name="MicBox" SelectionChanged="Setting_Changed"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Main language"/>
                        <ComboBox x:Name="LanguageBox" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Setting_Changed"/>
                        <TextBlock Style="{StaticResource FieldHelp}" Text="The language you mostly dictate in. Choosing it is more reliable than letting Murmur guess."/>
                        <StackPanel x:Name="SecondLanguagePanel">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Second language"/>
                            <ComboBox x:Name="SecondLanguageBox" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Setting_Changed"/>
                            <TextBlock Style="{StaticResource FieldHelp}" Text="If you also dictate in another language, Murmur picks between these two for each sentence."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Speech recognition"/>
                        <Border Style="{StaticResource SegTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EngineLocal" GroupName="Engine" Style="{StaticResource Seg}" Content="On this PC" Checked="Setting_Changed"/>
                                <RadioButton x:Name="EngineCloud" GroupName="Engine" Style="{StaticResource Seg}" Content="Cloud" Checked="Setting_Changed"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="LocalPanel">
                            <TextBlock Style="{StaticResource FieldHelp}" Text="Private, free and works offline. Audio never leaves this PC."/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Speech model"/>
                            <ComboBox x:Name="ModelBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="Model_Changed"/>
                            <TextBlock Style="{StaticResource FieldHelp}" Text="A model downloads once, the first time you pick it. Bigger models are more accurate and slower. A graphics card is used when there is one."/>
                        </StackPanel>
                        <StackPanel x:Name="CloudPanel">
                            <TextBlock Style="{StaticResource FieldHelp}" Text="Fastest. Your audio is sent to the provider you enter here."/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="API address"/>
                            <TextBox x:Name="SttUrlBox" LostFocus="Setting_Changed"/>
                            <TextBlock Style="{StaticResource FieldHelp}" Text="Any OpenAI-compatible service, such as Groq or OpenAI."/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Model"/>
                            <TextBox x:Name="SttModelBox" LostFocus="Setting_Changed"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="API key"/>
                            <PasswordBox x:Name="SttKeyBox" LostFocus="Setting_Changed"/>
                            <TextBlock Style="{StaticResource FieldHelp}" Text="Stored encrypted for your Windows account."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="AI model"/>
                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Polish dictations with AI"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Fixes grammar, applies corrections you say aloud, formats lists and matches the tone. Command mode uses the same model."/>
                            </StackPanel>
                            <CheckBox x:Name="AiCleanupBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Polish dictations with AI"/>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="API address"/>
                        <TextBox x:Name="LlmUrlBox" LostFocus="Setting_Changed"/>
                        <TextBlock Style="{StaticResource FieldHelp}" Text="Any OpenAI-compatible service. To keep everything on this PC, use Ollama at http://localhost:11434/v1"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Model"/>
                        <TextBox x:Name="LlmModelBox" LostFocus="Setting_Changed"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="API key"/>
                        <PasswordBox x:Name="LlmKeyBox" LostFocus="Setting_Changed"/>
                        <TextBlock Style="{StaticResource FieldHelp}" Text="Not needed for a local address."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Behaviour" Margin="0,0,0,4"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Remove filler words"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Drops um and uh from what you say."/>
                            </StackPanel>
                            <CheckBox x:Name="FillersBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Remove filler words"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Add a space after each dictation"/>
                                <TextBlock Style="{StaticResource Caption}" Text="So the next sentence does not run into the last one."/>
                            </StackPanel>
                            <CheckBox x:Name="TrailingSpaceBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Add a space after each dictation"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Restore my clipboard"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Puts back what you had copied after the text is inserted."/>
                            </StackPanel>
                            <CheckBox x:Name="RestoreClipboardBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Restore my clipboard"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Start and stop sounds"/>
                                <TextBlock Style="{StaticResource Caption}" Text="A short tone when recording begins and ends."/>
                            </StackPanel>
                            <CheckBox x:Name="SoundsBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Start and stop sounds"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Show the pill when idle"/>
                                <TextBlock Style="{StaticResource Caption}" Text="A small mark at the bottom of the screen shows Murmur is ready."/>
                            </StackPanel>
                            <CheckBox x:Name="RestPillBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Show the pill when idle"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Start with Windows"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Murmur waits in the tray after you sign in."/>
                            </StackPanel>
                            <CheckBox x:Name="StartupBox" Grid.Column="1" Click="Setting_Changed" AutomationProperties.Name="Start with Windows"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DataPathText" Style="{StaticResource Caption}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
