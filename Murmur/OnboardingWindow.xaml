<Window x:Class="Murmur.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Murmur" Width="880" Height="700" MinWidth="760" MinHeight="660"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource FontBody}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!--
        First-run setup: welcome, microphone, languages, hotkey practice, done. Every step can be skipped.
        Built from the same styles as the main window (App.xaml); one voice lead per step, the Continue button.
    -->
    <Window.Resources>
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource DisplayLg}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StepLead" TargetType="TextBlock" BasedOn="{StaticResource BodyMuted}">
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="MaxWidth" Value="580"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>
        <Style x:Key="StepCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,24,0,0"/>
            <Setter Property="Padding" Value="24,4"/>
        </Style>
        <Style x:Key="StepRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,16"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>
        <!-- A sunken plate that holds what Murmur heard. -->
        <Style x:Key="HeardPlate" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunken}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="72"/>
        </Style>
        <Style x:Key="TipKeys" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Ground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: the wordmark, and where you are in the five steps. -->
        <DockPanel Margin="48,32,48,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StepCount" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel x:Name="StepMarks" Orientation="Horizontal" VerticalAlignment="Center"
                            AutomationProperties.Name="Setup progress"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Control Style="{StaticResource Mark}" Height="22" VerticalAlignment="Bottom"/>
                <TextBlock Text="murmur" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="21"
                           Margin="7,0,0,-4" VerticalAlignment="Bottom" Foreground="{DynamicResource Ink}"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== Steps ===== -->
        <Grid Grid.Row="1" Margin="48,40,48,0">

            <!-- 1. Welcome -->
            <StackPanel x:Name="StepWelcome" VerticalAlignment="Center" Margin="0,0,0,40">
                <Control Style="{StaticResource Mark}" Height="72" HorizontalAlignment="Left" Margin="0,0,0,32"/>
                <TextBlock Style="{StaticResource DisplayLg}" FontSize="52" LineHeight="54" Text="Speak. It types."/>
                <TextBlock Style="{StaticResource StepLead}" FontSize="16" LineHeight="26" Margin="0,16,0,0"
                           Text="Murmur turns what you say into text in any app on this PC. Setup takes about a minute: pick a microphone, choose your languages and try the hotkey."/>
                <TextBlock x:Name="WelcomeHint" Style="{StaticResource BodyMuted}" Margin="0,28,0,0" LineHeight="28"/>
            </StackPanel>

            <!-- 2. Microphone -->
            <StackPanel x:Name="StepMic" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepTitle}" Text="Pick your microphone"/>
                <TextBlock Style="{StaticResource StepLead}" Text="Talk for a moment and watch the bars move. Then test it: Murmur writes down what it heard."/>
                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource StepRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Microphone"/>
                                <TextBlock x:Name="MicHelp" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="The level shows what Murmur hears right now."/>
                            </StackPanel>
                            <ComboBox x:Name="MicBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="MicBox_SelectionChanged"
                                      AutomationProperties.Name="Microphone"/>
                        </Grid>
                        <!-- The level meter: recent loudness as bars, the newest one is the caret. -->
                        <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Height="64" Padding="16,0" Margin="0,0,0,16">
                            <StackPanel x:Name="Meter" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        AutomationProperties.Name="Microphone level"/>
                        </Border>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource StepRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Say something"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="For example “Hej, det her er en test” or “This is a test”. Murmur listens for up to 6 seconds."/>
                            </StackPanel>
                            <Button x:Name="TestButton" Grid.Column="1" VerticalAlignment="Center" MinWidth="168" Content="Test the microphone" Click="Test_Click"/>
                        </Grid>
                        <Border Style="{StaticResource HeardPlate}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl x:Name="TestTag" DockPanel.Dock="Right" Style="{StaticResource Tag}" Visibility="Collapsed"/>
                                    <TextBlock Style="{StaticResource Overline}" Text="MURMUR HEARD" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="TestText" Style="{StaticResource BodyMuted}" FontFamily="{StaticResource FontMono}" FontSize="13"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Text="Nothing yet."/>
                                <TextBlock x:Name="TestLanguageNote" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Languages -->
            <StackPanel x:Name="StepLanguages" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepTitle}" Text="Which languages do you speak?"/>
                <TextBlock Style="{StaticResource StepLead}" Text="Murmur listens for these. Naming them beats letting it guess, especially for short sentences."/>
                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource StepRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Main language"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="The language you mostly speak."/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectionChanged="Language_Changed" AutomationProperties.Name="Main language"/>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid x:Name="SecondLanguageRow" Style="{StaticResource StepRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Label}" Text="Second language"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Optional. With two, Murmur picks between them for each sentence, so you can switch whenever you like."/>
                            </StackPanel>
                            <ComboBox x:Name="SecondLanguageBox" Grid.Column="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectionChanged="Language_Changed" AutomationProperties.Name="Second language"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap"
                           Text="You can change these, the speech model and the hotkeys in Settings at any time."/>
            </StackPanel>

            <!-- 4. Hotkey practice -->
            <StackPanel x:Name="StepPractice" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepTitle}" Text="Try the hotkey"/>
                <TextBlock x:Name="PracticeLead" Style="{StaticResource StepLead}" LineHeight="28"/>
                <Border Style="{StaticResource StepCard}" Padding="24">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <ContentControl x:Name="PracticeTag" DockPanel.Dock="Right" Style="{StaticResource Tag}" Content="Waiting for you"/>
                            <TextBlock Style="{StaticResource Overline}" Text="PRACTICE" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <TextBox x:Name="PracticeBox" Style="{StaticResource InputMultiline}" Height="112" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="PracticeBox_TextChanged"
                                     AutomationProperties.Name="Practice box"/>
                            <TextBlock x:Name="PracticePlaceholder" Style="{StaticResource BodyMuted}" Margin="14,10,14,0" IsHitTestVisible="False"
                                       Text="Your words land here."/>
                        </Grid>
                        <TextBlock x:Name="PracticeResult" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 5. Done -->
            <StackPanel x:Name="StepDone" Visibility="Collapsed">
                <TextBlock Style="{StaticResource StepTitle}" Text="You are ready"/>
                <TextBlock Style="{StaticResource StepLead}" Text="Murmur waits in the tray. Click into any text field, hold the hotkey and talk. A few more things worth knowing:"/>
                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource StepRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ContentControl x:Name="TipHandsFreeKeys" Style="{StaticResource TipKeys}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Label}" Text="Hands-free"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Double-tap the hotkey and talk as long as you like. Press it once more to finish."/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource StepRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ContentControl x:Name="TipCommandKeys" Style="{StaticResource TipKeys}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Label}" Text="Command mode"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Select text and say what to change, such as “make this shorter” or “gør det kortere”. With nothing selected, ask Murmur to write something. Needs AI polish in Settings."/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource StepRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ContentControl x:Name="TipCancelKeys" Style="{StaticResource TipKeys}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Label}" Text="Changed your mind"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Press Esc while recording and nothing is typed."/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowLine}"/>
                        <Grid Style="{StaticResource StepRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="ScreenContextBox" VerticalAlignment="Top" Margin="0,2,0,0" Click="ScreenContext_Click"
                                      AutomationProperties.Name="Use text around the cursor"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Label}" Text="Text around the cursor"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Murmur reads the text next to the cursor so names come out right. With AI polish, a short excerpt goes to your AI model, which may be a cloud service. Never from password fields or password managers. Turn it off here or in Settings."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer: skip on the left, back and continue on the right. -->
        <DockPanel Grid.Row="2" Margin="48,16,48,32" LastChildFill="False">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Style="{StaticResource BtnGhost}" Height="36" FontSize="14"
                    Content="Skip setup" Click="Skip_Click"/>
            <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" MinWidth="148"
                    Content="Get started" Click="Next_Click" IsDefault="True"/>
            <Button x:Name="BackButton" DockPanel.Dock="Right" MinWidth="96" Margin="0,0,12,0" Content="Back" Click="Back_Click"/>
        </DockPanel>
    </Grid>
</Window>
