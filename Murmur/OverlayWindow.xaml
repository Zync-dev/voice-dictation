<Window x:Class="Murmur.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" Width="760" Height="380"
        FontFamily="{StaticResource FontBody}" UseLayoutRounding="True"
        Title="Murmur dictation pill">
    <!--
        The dictation card. Hidden when idle; rises from the bottom of the screen while you dictate.
        The waveform flows into Murmur's caret: speech on the left, the text cursor on the right, as in the logo.
        While you speak, the words so far gather above it and end in a small caret. When the text has landed,
        the waveform folds into the caret, the caret becomes a tick, and the card holds what was inserted for a
        few seconds with keycaps to copy, undo or rewrite it.
        Keys are drawn as keycaps, and the keycaps are also the buttons.
        Transparent pixels pass clicks through; the keycaps can be clicked without taking focus from your app.
        Dark in both themes, overlay- colours only.
    -->
    <Window.Resources>
        <Style x:Key="PillKey" TargetType="Border">
            <Setter Property="BorderBrush" Value="#56727D"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,3,8,2"/>
            <Setter Property="Background" Value="#0C1215"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17232A"/>
                    <Setter Property="BorderBrush" Value="#93A9AC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PillKeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#EAF2F0"/>
        </Style>
        <Style x:Key="PillKeyHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#93A9AC"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A hairline between groups of keycaps. -->
        <Style x:Key="PillKeyGap" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
            <Setter Property="Fill" Value="#56727D"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Modes and voice commands: a thin scroll bar for a long answer from Ask, in overlay-line. -->
        <Style x:Key="PillScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#56727D" Opacity="0.8"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="PillHost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,44" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Lift" Y="14"/>
            </Grid.RenderTransform>

            <!-- Glow in the state colour, brighter as the voice gets louder. -->
            <Border x:Name="Glow" Height="22" VerticalAlignment="Bottom" Margin="40,0,40,-10" CornerRadius="11" Opacity="0">
                <Border.Effect><BlurEffect Radius="30"/></Border.Effect>
            </Border>

            <!-- Shadow carrier, so the card's own text stays crisp. -->
            <Border CornerRadius="28" Background="#0A0F12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.55" Color="Black"/>
                </Border.Effect>
            </Border>

            <Border x:Name="Pill" CornerRadius="28" Background="#0C1215" BorderThickness="1" Padding="22,0,14,0" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- The words so far while you speak; what was inserted afterwards. Grows upwards. -->
                    <Border x:Name="TextHost" Height="0" Padding="0,17,8,0" ClipToBounds="True" VerticalAlignment="Top">
                        <!-- Scrolls only for a long answer from Ask; everything else fits its lines. -->
                        <ScrollViewer x:Name="TextScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource PillScrollBar}"/>
                            </ScrollViewer.Resources>
                            <TextBlock x:Name="Words" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="#93A9AC"/>
                        </ScrollViewer>
                    </Border>

                    <DockPanel x:Name="MainRow" Grid.Row="1" Height="56" LastChildFill="False">
                        <!-- Waveform flowing into the caret; a tick replaces the caret when the text has landed. -->
                        <Grid DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="MeterScale" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>
                            <StackPanel x:Name="Meter" Orientation="Horizontal" Height="30" VerticalAlignment="Center"/>
                            <Path x:Name="Tick" Width="24" Height="24" HorizontalAlignment="Right" Data="M5,12.5 L9.5,17 L19,7.5"
                                  Stroke="#45E0BC" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  StrokeDashArray="8 8" StrokeDashOffset="8" Opacity="0"/>
                        </Grid>

                        <!-- While recording: the key that finishes, and Esc. -->
                        <StackPanel x:Name="Buttons" DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel x:Name="FinishGroup" Orientation="Horizontal" Margin="0,0,12,0">
                                <Border x:Name="StopButton" Style="{StaticResource PillKey}" ToolTip="Finish and insert">
                                    <TextBlock x:Name="FinishKeys" Style="{StaticResource PillKeyText}"/>
                                </Border>
                                <TextBlock x:Name="FinishHint" Style="{StaticResource PillKeyHint}" Text="insert"/>
                            </StackPanel>
                            <StackPanel x:Name="CancelGroup" Orientation="Horizontal">
                                <Border x:Name="CloseButton" Style="{StaticResource PillKey}" ToolTip="Cancel">
                                    <TextBlock Style="{StaticResource PillKeyText}" Text="Esc"/>
                                </Border>
                                <TextBlock Style="{StaticResource PillKeyHint}" Text="cancel"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- After inserting: what you can do with the text. -->
                        <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border x:Name="CopyKey" Tag="copy" Style="{StaticResource PillKey}" ToolTip="Copy the text">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Copy"/>
                            </Border>
                            <Border x:Name="UndoKey" Tag="undo" Style="{StaticResource PillKey}" Margin="6,0,0,0" ToolTip="Take the text back out of the app">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Undo"/>
                            </Border>
                            <StackPanel x:Name="RewriteKeys" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource PillKeyGap}"/>
                                <Border Tag="shorter" Style="{StaticResource PillKey}" ToolTip="Rewrite it shorter">
                                    <TextBlock Style="{StaticResource PillKeyText}" Text="Shorter"/>
                                </Border>
                                <Border Tag="formal" Style="{StaticResource PillKey}" Margin="6,0,0,0" ToolTip="Rewrite it formally">
                                    <TextBlock Style="{StaticResource PillKeyText}" Text="Formal"/>
                                </Border>
                                <Border Tag="casual" Style="{StaticResource PillKey}" Margin="6,0,0,0" ToolTip="Rewrite it casually">
                                    <TextBlock Style="{StaticResource PillKeyText}" Text="Casual"/>
                                </Border>
                            </StackPanel>
                            <Rectangle Style="{StaticResource PillKeyGap}"/>
                            <Border x:Name="DismissKey" Tag="close" Style="{StaticResource PillKey}" ToolTip="Close">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Esc"/>
                            </Border>
                        </StackPanel>

                        <!-- Modes and voice commands: the answer from Ask, which is shown and not typed. -->
                        <StackPanel x:Name="AnswerActions" DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border x:Name="AnswerCopyKey" Tag="answer-copy" Style="{StaticResource PillKey}" ToolTip="Copy the answer">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Copy"/>
                            </Border>
                            <Border x:Name="AnswerInsertKey" Tag="answer-insert" Style="{StaticResource PillKey}" Margin="6,0,0,0" ToolTip="Type the answer into the app you are in">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Insert"/>
                            </Border>
                            <!-- Problem reports: shown when the text did not land (OverlayWindow.Report.cs). -->
                            <Border x:Name="AnswerReportKey" Tag="report" Style="{StaticResource PillKey}" Margin="6,0,0,0" ToolTip="Make a problem report" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Report"/>
                            </Border>
                            <Rectangle Style="{StaticResource PillKeyGap}"/>
                            <Border x:Name="AnswerDismissKey" Tag="close" Style="{StaticResource PillKey}" ToolTip="Close">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Esc"/>
                            </Border>
                        </StackPanel>

                        <!-- Hands-free: an explicit yes before anything that cannot be taken back. The keycap names the action. -->
                        <StackPanel x:Name="ConfirmActions" DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <!-- Hands-free: computer control. "Which one?": a keycap per number (OverlayWindow.ShowChoices). -->
                            <StackPanel x:Name="ChoiceKeys" Orientation="Horizontal" Visibility="Collapsed"/>
                            <Border x:Name="ConfirmYesKey" Tag="confirm-yes" Style="{StaticResource PillKey}" ToolTip="Do it">
                                <TextBlock x:Name="ConfirmYesText" Style="{StaticResource PillKeyText}" Text="Send"/>
                            </Border>
                            <Rectangle x:Name="ConfirmGap" Style="{StaticResource PillKeyGap}"/>
                            <Border x:Name="ConfirmNoKey" Tag="confirm-no" Style="{StaticResource PillKey}" ToolTip="Cancel">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Esc"/>
                            </Border>
                        </StackPanel>

                        <!-- edit-speak: reading aloud. Speed keycaps, then Esc to stop. -->
                        <StackPanel x:Name="ReadingActions" DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border x:Name="ReadSlowerKey" Tag="read-slower" Style="{StaticResource PillKey}" ToolTip="Read slower">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Slower"/>
                            </Border>
                            <Border x:Name="ReadFasterKey" Tag="read-faster" Style="{StaticResource PillKey}" Margin="6,0,0,0" ToolTip="Read faster">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Faster"/>
                            </Border>
                            <Rectangle Style="{StaticResource PillKeyGap}"/>
                            <Border x:Name="ReadStopKey" Tag="read-stop" Style="{StaticResource PillKey}" ToolTip="Stop reading">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Esc"/>
                            </Border>
                            <TextBlock Style="{StaticResource PillKeyHint}" Text="stop"/>
                        </StackPanel>

                        <!-- Hands-free: multi-step tasks. Esc stops the task (OverlayWindow.Tasks.cs). -->
                        <StackPanel x:Name="TaskActions" DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <!-- Problem reports: a failed step offers a report (OverlayWindow.Report.cs). -->
                            <Border x:Name="TaskReportKey" Tag="report" Style="{StaticResource PillKey}" ToolTip="Make a problem report" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Report"/>
                            </Border>
                            <Rectangle x:Name="TaskReportGap" Style="{StaticResource PillKeyGap}" Visibility="Collapsed"/>
                            <Border x:Name="TaskStopKey" Tag="task-stop" Style="{StaticResource PillKey}" ToolTip="Stop the task">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Esc"/>
                            </Border>
                            <TextBlock x:Name="TaskStopHint" Style="{StaticResource PillKeyHint}" Text="stop"/>
                        </StackPanel>

                        <!-- Problem reports: an error on the card for a hands-free command offers a report (OverlayWindow.Report.cs). -->
                        <StackPanel x:Name="ErrorActions" DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border x:Name="ErrorReportKey" Tag="report" Style="{StaticResource PillKey}" ToolTip="Make a problem report">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Report"/>
                            </Border>
                            <Rectangle Style="{StaticResource PillKeyGap}"/>
                            <Border x:Name="ErrorDismissKey" Tag="close" Style="{StaticResource PillKey}" ToolTip="Close">
                                <TextBlock Style="{StaticResource PillKeyText}" Text="Esc"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="Timer" DockPanel.Dock="Right" Margin="18,0,0,0" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="#93A9AC" VerticalAlignment="Center"/>

                        <!-- Last, so the keycaps keep their room and a long status line is trimmed instead. -->
                        <TextBlock x:Name="Label" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14" MaxWidth="400" TextTrimming="CharacterEllipsis">
                            <Run x:Name="StatusRun" FontWeight="SemiBold" Foreground="#EAF2F0"/><Run x:Name="ContextRun" Foreground="#93A9AC"/>
                        </TextBlock>
                    </DockPanel>

                    <!-- How long the inserted text stays; it stops while the pointer is on the card. -->
                    <Rectangle x:Name="Countdown" Grid.Row="1" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                               Margin="2,0,10,6" Fill="#56727D" Opacity="0" RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="CountdownScale" ScaleX="1"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
