<Window x:Class="Murmur.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        IsHitTestVisible="False" ResizeMode="NoResize" Width="640" Height="150"
        FontFamily="{StaticResource FontBody}" UseLayoutRounding="True"
        Title="Murmur dictation pill">
    <!--
        The dictation pill (design-system/project/components/DictationPill).
        The window is a fixed transparent stage; only the pill inside it changes size, so nothing jitters.
        It is dark in both themes and uses the overlay- colours only.
    -->
    <Grid>
        <Grid x:Name="PillHost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,36" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Shake"/>
            </Grid.RenderTransform>

            <!-- Glow: the state colour, brighter as the voice gets louder. -->
            <Border x:Name="Glow" Height="18" VerticalAlignment="Bottom" Margin="22,0,22,-8" CornerRadius="9" Opacity="0">
                <Border.Effect><BlurEffect Radius="22"/></Border.Effect>
            </Border>

            <!-- Shadow carrier, so the pill's own text stays crisp. -->
            <Border CornerRadius="22" Background="#0A0F12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black"/>
                </Border.Effect>
            </Border>

            <Border x:Name="Pill" Height="22" CornerRadius="22" Background="#0A0F12" BorderThickness="1" Padding="10,0" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The mark as a meter: four sound bars and the caret. -->
                    <Grid Width="32" Height="24" VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="MeterScale" ScaleX="0.5" ScaleY="0.5"/>
                        </Grid.LayoutTransform>
                        <StackPanel x:Name="Meter" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle x:Name="Bar1" Width="4" Height="19" RadiusX="2" RadiusY="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Bar2" Width="4" Height="13" RadiusX="2" RadiusY="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Bar3" Width="4" Height="7" RadiusX="2" RadiusY="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Bar4" Width="4" Height="13" RadiusX="2" RadiusY="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Caret" Width="4" Height="24" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Path x:Name="Tick" Width="24" Height="24" HorizontalAlignment="Center" Data="M5,12.5 L9.5,17 L19,7.5"
                              Stroke="#45E0BC" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              StrokeDashArray="8 8" StrokeDashOffset="8" Opacity="0"/>
                    </Grid>

                    <Border x:Name="LabelClip" MaxWidth="0" Opacity="0" ClipToBounds="True">
                        <TextBlock x:Name="Label" Margin="12,0,0,0" FontSize="13" FontWeight="Medium" Foreground="#EAF2F0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Border x:Name="HintClip" MaxWidth="0" Opacity="0" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border BorderBrush="#56727D" BorderThickness="1,1,1,2" CornerRadius="6" Padding="5,1,5,0" VerticalAlignment="Center">
                                <TextBlock Text="Esc" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="Medium" Foreground="#EAF2F0"/>
                            </Border>
                            <TextBlock Text="cancel" Margin="5,0,0,0" FontSize="13" FontWeight="Medium" Foreground="#93A9AC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
